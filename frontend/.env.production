# Used only by `npm run build`. Backend and frontend share one origin in the
# combined deploy, so the API is reached by a relative path — no CORS needed.
VITE_API_URL=/api

# Not set here on purpose: VITE_GOOGLE_MAPS_API_KEY must be provided as a real
# environment variable at build time (e.g. in Laravel Cloud's build settings),
# so the production key never gets committed to the repo.
